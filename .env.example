# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Any OpenAI-compatible chat endpoint. Defaults point at DeepSeek.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# System prompt: who the bot is and how it should answer.
SYSTEM_PROMPT=Kamu asisten WhatsApp pribadi. Jawab singkat, ramah, dalam bahasa yang sama dengan pengirim.

# The number the bot runs on (digits, country code). Set = link with a pairing code
# instead of a QR. Leave empty to scan a QR.
BOT_NUMBER=

# Who the bot may answer: comma-separated numbers, digits only, with country code.
# Empty = answer nobody (safe default). * = answer anyone (capped per sender, see below). Unknown senders are logged so you can add them.
ALLOWED_NUMBERS=

# Safety limits
MAX_REPLIES_PER_HOUR=30
MAX_REPLIES_PER_SENDER_PER_HOUR=10
HISTORY_TURNS=10
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=5000
