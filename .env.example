# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Free providers, tried in this order (same chain as the zaidanlab.dev chat). Leave a key
# empty to skip that provider. Workers AI needs an API token with the "Workers AI" permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=
OLLAMA_API_KEY=
NVIDIA_API_KEY=
REQUESTY_API_KEY=

# Paid last resort: any OpenAI-compatible chat endpoint. Defaults point at DeepSeek.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Answer as Zai, ZaidanLab's assistant, using this llms.txt as knowledge (fetched, cached 10 min).
# Leave empty to use SYSTEM_PROMPT instead.
KNOWLEDGE_URL=https://zaidanlab.dev/llms.txt

# System prompt when KNOWLEDGE_URL is empty: who the bot is and how it should answer.
SYSTEM_PROMPT=Kamu asisten WhatsApp pribadi. Jawab singkat, ramah, dalam bahasa yang sama dengan pengirim.

# The number the bot runs on (digits, country code). Set = link with a pairing code
# instead of a QR. Leave empty to scan a QR.
BOT_NUMBER=

# Who the bot may answer: comma-separated numbers, digits only, with country code.
# Empty = answer nobody (safe default). * = answer anyone (capped per sender, see below). Unknown senders are logged so you can add them.
ALLOWED_NUMBERS=

# Safety limits
MAX_REPLIES_PER_HOUR=30
MAX_REPLIES_PER_SENDER_PER_HOUR=10
HISTORY_TURNS=10
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=5000
